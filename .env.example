# Puerto
#PORT=4000

# Entorno
#NODE_ENV=development

# MongoDB Atlas (requerido en producción)
#MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster.mongodb.net/pos?retryWrites=true&w=majority

# Dominio del frontend (Vercel producción)
